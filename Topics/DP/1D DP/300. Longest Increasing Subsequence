class Solution:
    def lengthOfLIS(self, nums: list[int]) -> int:
        ##nlogn complexity

        subseq=[]

        for num in nums:
            left, right =0, len(subseq)

            while(left<right):
                mid=(left+right)//2

                if subseq[mid]<num:
                    left=mid+1
                else:
                    right=mid

            if left==len(subseq):
                subseq.append(num)
            else:
                subseq[left]=num


        return len(subseq)

