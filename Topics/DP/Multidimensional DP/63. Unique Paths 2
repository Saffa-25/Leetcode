class Solution:
    def uniquePathsWithObstacles(self, obstacleGrid: list[list[int]]) -> int:
        ### n space complexity
        leng, heig=len(obstacleGrid), len(obstacleGrid[0])
        if obstacleGrid[leng-1][heig-1]==1:
            return 0
        
        dp=[0]*heig

        for i in range(leng-1, -1, -1):
            for j in range(heig-1, -1, -1):
                if obstacleGrid[i][j]==1:
                    dp[j]=0
                elif (i==leng-1 and j==heig-1):
                    dp[j]=1
                elif i+1==leng:
                    dp[j]=dp[j+1]
                elif j+1==heig:
                    dp[j]=dp[j]
                else:
                    dp[j]=dp[j]+dp[j+1]
        
        return dp[0]

